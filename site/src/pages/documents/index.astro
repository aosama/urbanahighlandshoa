---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { siteConfig } from '../../lib/siteConfig';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Documents">
  <Header />

  <main id="main-content" class="flex-1">
    <!-- Compact dark header -->
    <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-6 py-10 text-center">
      <div class="mx-auto max-w-4xl">
        <h1 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
          <span class="bg-gradient-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent">Frequently Used Documents</span>
        </h1>
        <p class="mx-auto mt-2 max-w-xl text-sm text-slate-400">
          Planning an exterior change? Start here.
        </p>
      </div>
    </div>

    <!-- All content above the fold -->
    <div class="bg-slate-50 px-6 py-8">
      <div class="mx-auto max-w-5xl space-y-5">

        <!-- CiraNet banner -->
        <a
          href={siteConfig.links.residentPortal}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-4 rounded-2xl border border-sky-200 bg-gradient-to-r from-sky-50 to-white px-6 py-4 shadow-sm transition hover:border-sky-300 hover:shadow-md"
        >
          <div class="flex items-center gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-lg">
              🔗
            </div>
            <div>
              <p class="text-lg font-semibold text-slate-900">Need other documents?</p>
              <p class="text-lg text-slate-500">Log into <span class="font-medium text-sky-700">CiraNet Resident Portal</span> for the full library of HOA documents, forms, and records.</p>
            </div>
          </div>
          <svg class="h-5 w-5 shrink-0 text-sky-500 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Two cards side by side -->
        <div class="grid gap-5 md:grid-cols-2">

          <!-- Step 1: Design Guidelines -->
          <a
            href={`${basePath}docs/design-guidelines-and-architectural-procedures.pdf`}
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-emerald-300 hover:shadow-lg"
            target="_blank"
            rel="noreferrer"
          >
            <!-- Illustration: house blueprint / ruler -->
            <div class="relative flex h-44 items-center justify-center bg-gradient-to-br from-emerald-100 via-teal-50 to-slate-100">
              <svg class="h-32 w-32 text-emerald-700" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- House body -->
                <rect x="30" y="55" width="60" height="40" rx="3" fill="currentColor" opacity="0.22" stroke="currentColor" stroke-width="2.5"/>
                <!-- Roof -->
                <path d="M25 58L60 30L95 58" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" fill-opacity="0.12"/>
                <!-- Door -->
                <rect x="52" y="72" width="16" height="23" rx="2" fill="currentColor" opacity="0.3" stroke="currentColor" stroke-width="2"/>
                <circle cx="65" cy="84" r="1.5" fill="currentColor" opacity="0.7"/>
                <!-- Window left -->
                <rect x="35" y="64" width="12" height="10" rx="1.5" fill="white" stroke="currentColor" stroke-width="2"/>
                <line x1="41" y1="64" x2="41" y2="74" stroke="currentColor" stroke-width="1.2"/>
                <line x1="35" y1="69" x2="47" y2="69" stroke="currentColor" stroke-width="1.2"/>
                <!-- Window right -->
                <rect x="73" y="64" width="12" height="10" rx="1.5" fill="white" stroke="currentColor" stroke-width="2"/>
                <line x1="79" y1="64" x2="79" y2="74" stroke="currentColor" stroke-width="1.2"/>
                <line x1="73" y1="69" x2="85" y2="69" stroke="currentColor" stroke-width="1.2"/>
                <!-- Ruler overlay -->
                <rect x="14" y="85" width="92" height="8" rx="2" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="1.5"/>
                <line x1="24" y1="85" x2="24" y2="90" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="34" y1="85" x2="34" y2="90" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="44" y1="85" x2="44" y2="93" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="54" y1="85" x2="54" y2="90" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="64" y1="85" x2="64" y2="90" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="74" y1="85" x2="74" y2="93" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="84" y1="85" x2="84" y2="90" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <line x1="94" y1="85" x2="94" y2="90" stroke="currentColor" stroke-width="1" opacity="0.6"/>
                <!-- Chimney -->
                <rect x="72" y="38" width="8" height="17" rx="1" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              <!-- Step badge overlay -->
              <div class="absolute left-4 top-4 flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-600 text-sm font-bold text-white shadow-sm">1</span>
                <span class="text-sm font-bold uppercase tracking-widest text-emerald-700">Read first</span>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <h2 class="text-xl font-semibold tracking-tight text-slate-900">Design Guidelines &amp; Architectural Procedures</h2>

              <p class="mt-1.5 text-base leading-relaxed text-slate-600">
                Find the rules that apply to your project -- materials, colors, setbacks, and review requirements.
              </p>

              <div class="mt-auto flex items-center justify-between gap-4 border-t border-slate-100 pt-3 mt-4">
                <span class="text-sm text-slate-400">PDF &middot; 166 pages</span>
                <span class="inline-flex items-center gap-1.5 text-base font-semibold text-emerald-700 transition group-hover:translate-x-0.5">
                  Open
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" /></svg>
                </span>
              </div>
            </div>
          </a>

          <!-- Step 2: Change Request Form -->
          <a
            href={`${basePath}docs/architectural-change-request-form.pdf`}
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-emerald-300 hover:shadow-lg"
            target="_blank"
            rel="noreferrer"
          >
            <!-- Illustration: clipboard / form -->
            <div class="relative flex h-44 items-center justify-center bg-gradient-to-br from-slate-200 via-sky-100 to-slate-100">
              <svg class="h-32 w-32 text-slate-700" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Clipboard body -->
                <rect x="30" y="25" width="60" height="78" rx="5" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2.5"/>
                <!-- Clipboard clip -->
                <rect x="45" y="19" width="30" height="14" rx="3" fill="white" stroke="currentColor" stroke-width="2.5"/>
                <circle cx="60" cy="26" r="3" fill="currentColor" opacity="0.4" stroke="currentColor" stroke-width="1.5"/>
                <!-- Form lines -->
                <line x1="40" y1="45" x2="80" y2="45" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                <line x1="40" y1="55" x2="72" y2="55" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                <line x1="40" y1="65" x2="78" y2="65" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                <line x1="40" y1="75" x2="68" y2="75" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                <!-- Checkmarks -->
                <path d="M38 43L40 45.5L44 41" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" transform="translate(-5, 0)"/>
                <path d="M38 53L40 55.5L44 51" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" transform="translate(-5, 0)"/>
                <path d="M38 63L40 65.5L44 61" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" transform="translate(-5, 0)"/>
                <!-- Pen -->
                <g transform="translate(68, 72) rotate(-35)">
                  <rect x="0" y="0" width="5" height="28" rx="1.5" fill="currentColor" opacity="0.35" stroke="currentColor" stroke-width="1.2"/>
                  <polygon points="0,28 5,28 2.5,34" fill="currentColor" opacity="0.5"/>
                  <rect x="0" y="0" width="5" height="6" rx="1" fill="currentColor" opacity="0.25"/>
                </g>
                <!-- Signature line -->
                <line x1="40" y1="90" x2="80" y2="90" stroke="currentColor" stroke-width="2" stroke-dasharray="3 2" opacity="0.4"/>
                <text x="40" y="98" font-size="6" fill="currentColor" opacity="0.5" font-family="sans-serif">Signature</text>
              </svg>
              <!-- Step badge overlay -->
              <div class="absolute left-4 top-4 flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-700 text-sm font-bold text-white shadow-sm">2</span>
                <span class="text-sm font-bold uppercase tracking-widest text-slate-500">Then fill &amp; submit</span>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <h2 class="text-xl font-semibold tracking-tight text-slate-900">Architectural Change Request Form</h2>

              <p class="mt-1.5 text-base leading-relaxed text-slate-600">
                Once you know which rules apply, fill out this form and submit it for ARC approval before starting work.
              </p>

              <div class="mt-auto flex items-center justify-between gap-4 border-t border-slate-100 pt-3 mt-4">
                <span class="text-sm text-slate-400">PDF &middot; 4 pages</span>
                <span class="inline-flex items-center gap-1.5 text-base font-semibold text-emerald-700 transition group-hover:translate-x-0.5">
                  Download
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-5-5m5 5l5-5" /></svg>
                </span>
              </div>
            </div>
          </a>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
