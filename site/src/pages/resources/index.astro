---
import PageLayout from '../../layouts/PageLayout.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const resourceCategories = [
  {
    title: 'Education & Schools',
    icon: '🏫',
    resources: [
      { name: 'Frederick County Public Schools (FCPS)', url: 'https://www.fcps.org' },
      { name: 'FCPS School Locator', url: 'https://www.fcps.org/schools/find_your_school_feeder_area' },
      { name: 'Frederick County Public Libraries', url: 'https://www.fcpl.org' },
    ],
  },
  {
    title: 'Emergency & Safety',
    icon: '🚒',
    resources: [
      { name: 'Frederick County Fire & Rescue', url: 'https://frederickcountymd.gov/24/Division-of-Fire-Rescue-Services-DFRS' },
      { name: 'Frederick County Sheriff (non-emergency)', url: 'https://frederickcountymd.gov/677/Sheriff-Adult-Detention' },
      { name: 'Poison Control (1-800-222-1222)', url: 'https://poisonhelp.hrsa.gov' },
      { name: 'Frederick County Emergency Management', url: 'https://frederickcountymd.gov/2001/Emergency-Management' },
    ],
  },
  {
    title: 'Government & Utilities',
    icon: '🏛️',
    resources: [
      { name: 'Frederick County Government Portal', url: 'https://frederickcountymd.gov' },
      { name: 'Trash & Recycling (County Solid Waste)', url: 'https://frederickcountymd.gov/solidwaste' },
      { name: 'City of Frederick Water/Sewer', url: 'https://www.cityoffrederickmd.gov/69/Water-Sewer' },
      { name: 'Potomac Edison Outages', url: 'https://www.firstenergycorp.com/outages' },
      { name: 'BGE Outages', url: 'https://outagemap.bge.com' },
    ],
  },
  {
    title: 'Transportation',
    icon: '🚗',
    resources: [
      { name: 'MD 511 Road Conditions', url: 'https://chart.maryland.gov' },
      { name: 'MARC Train (commuter rail)', url: 'https://www.mta.maryland.gov/marc-train' },
      { name: 'Frederick County TransIT', url: 'https://frederickcountymd.gov/transit' },
    ],
  },
  {
    title: 'Parks & Recreation',
    icon: '🌳',
    resources: [
      { name: 'Frederick County Parks & Rec', url: 'https://www.recreater.com' },
      { name: 'Urbana District Park', url: 'https://www.recreater.com/272/Urbana-District-Park' },
      { name: 'Maryland State Parks', url: 'https://dnr.maryland.gov/publiclands' },
    ],
  },
  {
    title: 'Pet Owners',
    icon: '🐾',
    resources: [
      { name: 'Frederick County Animal Control', url: 'https://frederickcountymd.gov/15/Animal-Control' },
      { name: 'Dog/Cat License & Rabies', url: 'https://frederickcountymd.gov/124/Rabies-Licensing' },
    ],
  },
];
---

<PageLayout title="Community Resources">
  <Fragment slot="title">
    <span class="bg-gradient-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent">Community Resources</span>
  </Fragment>

  <p class="mb-8 text-center text-lg text-slate-600">
    Helpful links to local government services, schools, emergency contacts, and public amenities.
  </p>

  <!-- Featured: Recycle Coach App -->
  <div class="mb-8 overflow-hidden rounded-2xl border border-green-200 bg-gradient-to-br from-green-50 via-white to-emerald-50 shadow-md">
    <div class="flex flex-col md:flex-row">
      <!-- Left: App images -->
      <div class="flex flex-row items-center justify-center gap-3 bg-gradient-to-br from-green-100 to-emerald-100 p-4 md:w-2/5 md:flex-col md:gap-4 md:p-6">
        <img
          src={`${basePath}assets/community/recycle-coach.png`}
          alt="Recycle Coach mobile app"
          class="h-auto max-h-32 w-auto max-w-[45%] rounded-xl shadow-lg md:max-h-48 md:max-w-full"
        />
        <img
          src={`${basePath}assets/community/recycle-coach-schedule.jpg`}
          alt="Recycle Coach pickup schedule view"
          class="h-auto max-h-32 w-auto max-w-[50%] rounded-xl shadow-lg md:max-h-48 md:max-w-full"
        />
      </div>
      <!-- Right: Info & links -->
      <div class="flex flex-col justify-center p-6 md:w-3/5 md:p-8">
        <div class="mb-2 flex items-center gap-2">
          <span class="inline-flex items-center rounded-full bg-green-600 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">Recycling</span>
          <span class="inline-flex items-center rounded-full border border-green-300 bg-green-50 px-3 py-0.5 text-xs font-medium text-green-700">Free App</span>
        </div>
        <h2 class="mb-2 text-2xl font-bold text-slate-900">Recycle Coach</h2>
        <p class="mb-4 text-base leading-relaxed text-slate-600">
          Never miss a recycling or trash pickup day. <strong>Recycle Coach</strong> is a free app from Frederick County
          that gives you your personalized collection schedule, holiday reminders, and a
          <em>"What Goes Where?"</em> search so you always know how to dispose of any item.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://play.google.com/store/apps/details?id=mobi.recyclecoach.worldster.pack"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow transition hover:bg-green-700 hover:shadow-md"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.482 1.436c.871.504.871 1.608 0 2.112l-2.482 1.436-2.551-2.551 2.551-2.433zM5.864 1.458L16.8 7.79l-2.302 2.302-8.634-8.634z"/></svg>
            Google Play
          </a>
          <a
            href="https://apps.apple.com/us/app/recycle-coach/id1071714967"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow transition hover:bg-slate-800 hover:shadow-md"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            App Store
          </a>
          <a
            href="https://frederickcountymd.gov/5287/MyWaste-Mobile-App"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-green-300 bg-white px-4 py-2.5 text-sm font-semibold text-green-700 transition hover:bg-green-50"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            County Recycling Info
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured: Community Trash Service -->
  <div class="mb-8 overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 via-white to-orange-50 shadow-md">
    <div class="flex flex-col md:flex-row">
      <div class="flex items-center justify-center bg-gradient-to-br from-amber-100 to-orange-100 p-6 md:w-2/5 md:p-8">
        <div class="w-full max-w-md rounded-2xl border border-amber-200 bg-white/80 p-5 shadow-sm backdrop-blur">
          <div class="mb-3 flex items-center gap-2">
            <span class="text-2xl" aria-hidden="true">🗑️</span>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700">Urbana Highlands</p>
          </div>
          <h3 class="mb-2 text-xl font-bold text-slate-900">Trash Service Provider</h3>
          <p class="text-sm leading-relaxed text-slate-600">
            <strong>J &amp; J Trash Service, Inc.</strong><br />
            Main: <a href="tel:3012451002" class="font-semibold text-amber-700 hover:text-amber-800">(301) 245-1002</a><br />
            Alternate: <a href="tel:3018982109" class="font-semibold text-amber-700 hover:text-amber-800">(301) 898-2109</a>
          </p>
          <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-relaxed text-amber-900">
            Frederick County does not provide residential trash pickup for this community.
            Trash service is arranged through the HOA.
          </p>
        </div>
      </div>

      <div class="flex flex-col justify-center p-6 md:w-3/5 md:p-8">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full bg-amber-600 px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">Trash Pickup</span>
          <span class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-3 py-0.5 text-xs font-medium text-amber-800">HOA-Contracted</span>
        </div>
        <h2 class="mb-2 text-2xl font-bold text-slate-900">Community Trash Collection</h2>
        <p class="mb-4 text-base leading-relaxed text-slate-600">
          For Urbana Highlands residents, trash pickup is handled by <strong>J &amp; J Trash Service, Inc.</strong>.
          Use the links below for support, account access, and service updates.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://www.facebook.com/JandJTrashInc"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-[#1877F2] px-4 py-2.5 text-sm font-semibold text-white shadow transition hover:brightness-95 hover:shadow-md"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.88 3.77-3.88 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>
            Facebook Updates
          </a>
          <a
            href="mailto:customerservice@jandjinctrashservice.com"
            class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow transition hover:bg-slate-800 hover:shadow-md"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l9 6 9-6m-18 8h18a2 2 0 002-2V8a2 2 0 00-2-2H3a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>
            Email Support
          </a>
          <a
            href="https://secure.soft-pak.com/webpakjt/signin.jsp"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-amber-300 bg-white px-4 py-2.5 text-sm font-semibold text-amber-800 transition hover:bg-amber-50"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a5 5 0 00-10 0v2m-2 0h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2v-8a2 2 0 012-2z" /></svg>
            Pay Online
          </a>
          <a
            href="https://www.urbanahighlandshoa.com/events/bulk-trash-pick-up-5-4-2024/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10m-11 9h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v11a2 2 0 002 2z" /></svg>
            HOA Bulk Pickup Notice
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {resourceCategories.map((category) => (
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
        <div class="mb-4 flex items-center gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-2xl">
            {category.icon}
          </div>
          <h2 class="text-xl font-semibold text-slate-900">{category.title}</h2>
        </div>
        <ul class="space-y-2">
          {category.resources.map((resource) => (
            <li>
              <a
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2 rounded-lg px-3 py-2 text-slate-700 transition hover:bg-slate-50"
              >
                <svg class="h-4 w-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span class="group-hover:text-emerald-600">{resource.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="mt-8 text-center text-sm text-slate-500">
    Links provided for convenience. Urbana Highlands HOA is not affiliated with these organizations.
  </p>
</PageLayout>
