---
import PageLayout from '../../layouts/PageLayout.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<PageLayout title="Events">
  <Fragment slot="title">
    <span class="bg-gradient-to-r from-sky-300 to-violet-300 bg-clip-text text-transparent">Events</span>
  </Fragment>

  <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
    <div class="flex items-start gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-2xl">
        ↗
      </div>
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Events are now part of News &amp; Events</h2>
        <p class="mt-2 text-slate-600">
          We combined the old standalone Events page into a single News &amp; Events page so updates and neighborhood
          happenings are easier to browse together.
        </p>
        <a
          class="mt-4 inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800"
          href={`${basePath}announcements/`}
        >
          Go to News &amp; Events
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</PageLayout>
